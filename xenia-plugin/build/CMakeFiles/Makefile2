xtLib/CMakeFiles/xtLib.dir/rule: cmake_check_build_system
	$(CMAKE_COMMAND) -E cmake_progress_start /home/user/puxenia/xenia-plugin/build/CMakeFiles 94
	$(MAKE) $(MAKESILENT) -f CMakeFiles/Makefile2 xtLib/CMakeFiles/xtLib.dir/all
	$(CMAKE_COMMAND) -E cmake_progress_start /home/user/puxenia/xenia-plugin/build/CMakeFiles 0
.PHONY : xtLib/CMakeFiles/xtLib.dir/rule

# Convenience name for target.
xtLib: xtLib/CMakeFiles/xtLib.dir/rule
.PHONY : xtLib

# clean rule for target.
xtLib/CMakeFiles/xtLib.dir/clean:
	$(MAKE) $(MAKESILENT) -f xtLib/CMakeFiles/xtLib.dir/build.make xtLib/CMakeFiles/xtLib.dir/clean
.PHONY : xtLib/CMakeFiles/xtLib.dir/clean

#=============================================================================
# Special targets to cleanup operation of make.

# Special rule to run CMake to check the build system integrity.
# No rule that depends on this can have commands that come from listfiles
# because they might be regenerated.
cmake_check_build_system:
	$(CMAKE_COMMAND) -S$(CMAKE_SOURCE_DIR) -B$(CMAKE_BINARY_DIR) --check-build-system CMakeFiles/Makefile.cmake 0
.PHONY : cmake_check_build_system

